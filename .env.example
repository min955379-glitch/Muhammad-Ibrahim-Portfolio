# --- Database -----------------------------------------------------------
# Local / hosted Postgres instance used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Site ---------------------------------------------------------------
# Canonical production origin. Used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://muhammad-ibrahim-portfolio-six.vercel.app

# --- Live data (optional) ------------------------------------------------
# Raises the GitHub API rate limit and enables private-repo metadata.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Contact delivery (optional) ----------------------------------------
# The contact form always writes to Postgres. When these are present the
# brief is additionally mirrored to Supabase and e-mailed through Resend.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_CONTACT_TABLE=contact_submissions
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Portfolio <onboarding@resend.dev>
# RESEND_TO=min955379@gmail.com
